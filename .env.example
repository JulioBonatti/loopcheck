# Copy to .env.local and adjust. Never commit real secrets.

# PostgreSQL connection (dev: docker compose, see docker-compose.yml)
DATABASE_URL=postgres://loopcheck:loopcheck@localhost:5432/loopcheck
# Database used by integration tests (wiped by the test setup)
TEST_DATABASE_URL=postgres://loopcheck:loopcheck@localhost:5432/loopcheck_test

# Directory for uploaded logos and generated PDFs
DATA_DIR=./data

# Random secret (>= 32 chars) used to hash session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string
